# Frontend (Bolt / Netlify / Vercel). Leave both empty to run the built-in demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (bot check on scans). https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=

# Supabase Edge Function secrets (set with: supabase secrets set KEY=value)
# SERPER_API_KEY=        # https://serper.dev  (recommended, Google results)
# BRAVE_API_KEY=         # https://brave.com/search/api  (optional second provider)
# SCAN_DAILY_LIMIT=300   # max scans per day across the site
# TURNSTILE_SECRET_KEY=  # Turnstile secret; when set, every scan needs a valid bot-check token
# IP_HASH_SALT=          # random string; visitor IPs are only stored as salted hashes
# CRON_SECRET=           # shared secret the re-check job sends
# STRIPE_SECRET_KEY=     # Stripe secret key (sk_test_... first, then sk_live_...)
# STRIPE_WEBHOOK_SECRET= # signing secret of the stripe-webhook endpoint (whsec_...)
# SITE_URL=              # your site's address, e.g. https://myfootprint.example; checkout returns here
# STRIPE_PRICE_ID=       # optional: a Price from your Stripe catalog instead of the built-in $19.99
# PRICE_CENTS=1999       # optional: price when STRIPE_PRICE_ID is not set
# PROMO_FREE_LIMIT=1000  # launch offer: first N homes unlock free (one per account); 0 ends it
# GOOGLE_REVIEW_URL=     # your Google Business Profile review link
# RESEND_API_KEY=        # https://resend.com, for the one follow-up review email
# EMAIL_FROM=            # e.g. HomePrint <hello@homeprint.online> (domain verified in Resend)
